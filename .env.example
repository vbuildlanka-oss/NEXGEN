# ─────────────────────────────────────────────────────────────────────────────
# NexGen — environment variables
# Copy to .env for local development. In production these are set in the
# Vercel project settings (Settings → Environment Variables).
# See docs/SETUP.md for exactly where each value comes from.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI.
# Use the "Session pooler" URI (port 5432) — it works for both runtime and
# migrations. Replace [YOUR-PASSWORD] with your database password.
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/nexgen

# ── Payload ──────────────────────────────────────────────────────────────────
# Any long random string. Generate with: openssl rand -base64 32
# Changing this invalidates all existing admin login sessions.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public origin of the site. Used for admin live preview, media URLs and emails.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Cloudflare R2 (image storage) ────────────────────────────────────────────
# Leave ALL of these blank to fall back to local disk storage (dev only —
# Vercel's filesystem is read-only, so R2 is required in production).
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
# The bucket's public URL — either the r2.dev subdomain or your custom domain.
R2_PUBLIC_URL=

# ── Resend (contact form email) ──────────────────────────────────────────────
# Leave blank to have contact submissions saved to the database only.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend.
CONTACT_EMAIL_FROM=NexGen Website <website@example.com>
# Where contact form submissions are delivered.
CONTACT_EMAIL_TO=hello@example.com

# ── Vercel Cron (keeps the Supabase free-tier project from pausing) ──────────
# Any long random string. Vercel sends it as a Bearer token on cron requests.
CRON_SECRET=change-me-to-a-long-random-string
